+
+    <title>{% block title %}{{ page_title }}{% endblock %}</title>
+    <meta name="description" content="{{ page_description }}" />
+    <link rel="canonical" href="{{ canonical_url }}" />
+    <meta name="robots" content="{{ robots|default:'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}" />
+    <meta name="theme-color" content="#f4f6fb" />
+    <meta name="color-scheme" content="light dark" />
+    <meta name="author" content="ارزلرن" />
+    <link rel="alternate" hreflang="fa-IR" href="{{ canonical_url }}" />
+    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}" />
+    <link rel="alternate" type="application/rss+xml" title="آخرین مطالب ارزلرن" href="{{ site_url }}/rss.xml" />
+
+    <meta property="og:locale" content="fa_IR" />
+    <meta property="og:site_name" content="ارزلرن" />
+    <meta property="og:type" content="{% block og_type %}website{% endblock %}" />
+    <meta property="og:title" content="{{ page_title }}" />
+    <meta property="og:description" content="{{ page_description }}" />
+    <meta property="og:url" content="{{ canonical_url }}" />
+    <meta property="og:image" content="{{ og_image }}" />
+    <meta property="og:image:alt" content="{{ page_title }}" />
+    {% block og_extra %}{% endblock %}
+
+    <meta name="twitter:card" content="summary_large_image" />
+    <meta name="twitter:title" content="{{ page_title }}" />
+    <meta name="twitter:description" content="{{ page_description }}" />
+    <meta name="twitter:image" content="{{ og_image }}" />
+
+    {% for block in json_ld_blocks %}<script type="application/ld+json">{{ block|safe }}</script>
+    {% endfor %}
+
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
+    <link
+      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
+      rel="stylesheet"
+    />
+
+    <!-- ست کردن تم قبل از رندر ری‌اکت تا صفحه یک لحظه سفید نزند -->
+    <script>
+      (function () {
+        var theme = 'light';
+        try {
+          var saved = localStorage.getItem('arzlearn-theme');
+          if (saved === 'dark' || saved === 'light') theme = saved;
+        } catch (e) {}
+        document.documentElement.setAttribute('data-theme', theme);
+      })();
+    </script>
+
+    {% for tag in assets.preloads %}{{ tag|safe }}{% endfor %}
+    {% for tag in assets.styles %}{{ tag|safe }}{% endfor %}
+
+    <style>
+      /* استایل حداقلی فقط برای لحظه‌ی قبل از اجرای ری‌اکت */
+      .pre{max-width:1240px;margin:0 auto;padding:16px 20px;font-family:Vazirmatn,Tahoma,sans-serif}
+      .pre h1{font-size:26px;margin:12px 0}
+      .pre h2{font-size:19px;margin:22px 0 10px}
+      .pre ul{list-style:none;padding:0;margin:0}
+      .pre li{margin:0 0 10px}
+      .pre a{color:inherit;text-decoration:none}
+      .pre nav a{display:inline-block;margin-left:14px;opacity:.85}
+      .pre time{opacity:.6;font-size:13px}
+    </style>
+  </head>
+  <body>
+    <!--
+      arzlearn:prerendered
+      محتوای زیر فقط نسخه‌ی ایستای صفحه برای خزنده‌های گوگل، بینگ و ربات‌های
+      شبکه‌های اجتماعی است. به محض اجرای جاوااسکریپت، ری‌اکت همین div را با
+      نسخه‌ی کامل و تعاملی سایت جایگزین می‌کند و کاربر واقعی هیچ تفاوتی
+      نمی‌بیند.
+    -->
+    <div id="root">{% block prerendered_body %}{% endblock %}</div>
+
+    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
+    <script>
+      window.dataLayer = window.dataLayer || [];
+      function gtag(){dataLayer.push(arguments);}
+      gtag('js', new Date());
+      gtag('config', '{{ ga_id }}');
+    </script>
+
+    {% for tag in assets.scripts %}{{ tag|safe }}{% endfor %}
+  </body>
+</html>
