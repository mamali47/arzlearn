+
+/** مسیر فارسی را percent-encode می‌کند تا URL معتبر باشد. */
+export function encodePath(path: string): string {
+  if (!path) return '/'
+  const withSlash = path.startsWith('/') ? path : `/${path}`
+  return withSlash
+    .split('/')
+    .map((segment) => encodeURIComponent(decodeURIComponent(segment)))
+    .join('/')
