# این فایل را کپی کرده و به نام .env ذخیره کنید و مقادیر واقعی را وارد کنید
SECRET_KEY=change-this-secret-key
# آدرس پنل ادمین؛ برای پروداکشن به یک مسیر غیرقابل‌حدس تغییر بده (باید با / تمام شود)
ADMIN_URL=admin/
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=arzlearn_db
DB_USER=arzlearn_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# آدرس عمومی فرانت‌اند و بک‌اند (برای Sitemap، Schema.org و لینک‌های تلگرام)
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://127.0.0.1:8000

# تلگرام - برای پست خودکار مقالات در کانال (از @BotFather بگیرید)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# اختیاری: اگر تلگرام از شبکه‌ی سرور فیلتر است، آدرس یک پروکسی HTTP/SOCKS5 بدهید
# مثال: http://127.0.0.1:10809  یا  socks5h://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# تقویم اقتصادی - کلید API سرویس دلخواه (مثلاً forex-calendar.pro)
ECONOMIC_CALENDAR_API_KEY=
ECONOMIC_CALENDAR_API_BASE_URL=https://api.forex-calendar.pro

# BrsApi.ir - کلید اختصاصی برای قیمت دلار و طلا (از brsapi.ir بگیرید)
BRSAPI_KEY=
